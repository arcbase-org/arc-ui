{
  "name": "@arcbaseorg/ui",
  "version": "0.1.2",
  "description": "Componenti React in vetro: finestre, sidebar, bottoni connessi, liste a fisarmonica, drawer e widget in stile iOS. Aggiornamento Dolomiti.",
  "license": "AGPL-3.0-only",
  "author": "ticly <info@ticly.it>",
  "homepage": "https://github.com/arcbase-org/arc-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcbase-org/arc-ui.git"
  },
  "bugs": {
    "url": "https://github.com/arcbase-org/arc-ui/issues"
  },
  "funding": "https://buymeacoffee.com/arcbase",
  "keywords": [
    "react",
    "components",
    "nextjs",
    "glassmorphism",
    "widgets",
    "arcbase",
    "ticly"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && cat src/styles/styles.css src/styles/additions.css > dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "docs": "node scripts/build-docs.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
